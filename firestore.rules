rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Party game rooms — open access by design (no accounts, join by code).
    // Codes are unguessable-enough for a casual party game; rooms hold no personal data.
    match /rooms/{code} {
      allow read: if true;
      allow create: if code.size() == 4
                    && request.resource.data.keys().hasAll(['code', 'state', 'players'])
                    && request.resource.data.code == code;
      allow update: if true;
      allow delete: if true;
    }
    // Connection heartbeat, one tiny document per room. Kept out of the room itself
    // because Firestore re-sends a whole document to every listener on every change —
    // beating inside the room would rebroadcast the entire game state every few seconds.
    match /pulses/{code} {
      allow read: if true;
      allow write: if code.size() == 4
                   && request.resource.data.keys().hasOnly(['at', 'by', 'code', 'expiresAt']);
      allow delete: if true;
    }
    // Everything else: locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
